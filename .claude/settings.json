{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "deny": [
      "Read(./prod-config/**)",
      "Read(./secrets/**)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./prod-config/**)",
      "Edit(./secrets/**)",
      "Write(./prod-config/**)",
      "Write(./secrets/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "allow": [
      "Read(./openapi/**)",
      "Read(./src/**)",
      "Read(./tickets/**)",
      "Read(./db/**)",
      "Read(./docs/**)",
      "Read(./README.md)",
      "Edit(./openapi/**)",
      "Edit(./src/**)",
      "Edit(./db/**)",
      "Edit(./docs/**)",
      "Edit(./README.md)",
      "Write(./db/**)",
      "Write(./docs/**)",
      "Write(./README.md)",
      "Bash(./mvnw:*)",
      "Bash(spectral:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-openapi.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-merge-diff.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-docs-check.sh" }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-sensitive-paths.sh" }
        ]
      }
    ],

    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-audit-report.sh" }
        ]
      }
    ]
  },

  "env": {
    "FRANCEAPI_DEMO_MODE": "live"
  }
}
