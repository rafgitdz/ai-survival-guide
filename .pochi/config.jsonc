// .pochi/config.jsonc: Pochi configuration, project scope (versioned in git).
// JSONC format: comments are allowed (// and /* */).
// For user scope (personal, not versioned), copy the entries into ~/.pochi/config.jsonc.
//
// Four MCP servers: tickets (Jira-like), git, database schema reader,
// contract-test-runner. The commands and URLs below are pluggable EXAMPLES:
// replace them with real targets before production.
{
  "mcp": {

    // MCP server exposing Jira-like tickets (placeholder package).
    // Provide JIRA_BASE_URL and JIRA_TOKEN through the environment, never hard-coded.
    "tickets": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything-tickets"],
      "env": {
        "JIRA_BASE_URL": "${JIRA_BASE_URL:-https://your-company.example.atlassian.net}",
        "JIRA_TOKEN": "${JIRA_TOKEN:-REPLACE_ME}"
      }
    },

    // Official git MCP server: history, diffs, blame.
    // Read-only for the demo (no commit through MCP).
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "."]
    },

    // MCP server reading the database schema (DDL only, no data, placeholder package).
    // Used by openapi-designer and owasp-reviewer so that they NEVER invent
    // a field (see AGENTS.md §6).
    "db-schema": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres-readonly"],
      "env": {
        "DATABASE_URL": "${DATABASE_URL:-postgres://demo:demo@localhost:5432/franceapi_demo}",
        "READ_ONLY": "true",
        "SCHEMA_ONLY": "true"
      }
    },

    // In-house MCP server exposing 'run_contract_tests', which runs mvnw test
    // on the *ContractTest suite and returns a structured report.
    // The referenced binary is a placeholder: replace it with the real implementation.
    "contract-test-runner": {
      "command": "node",
      "args": ["./mcp/contract-test-runner/index.js"],
      "env": {
        "MAVEN_OPTS": "-Xmx1g",
        "TEST_PATTERN": "*ContractTest"
      }
    }

  }
}
